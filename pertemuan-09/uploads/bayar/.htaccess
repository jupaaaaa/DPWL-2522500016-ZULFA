# P9: bukti pembayaran bersifat privat. Tidak boleh dibuka langsung lewat URL.
# Berkas hanya disajikan oleh Pembayaran_controller::bukti() setelah cek hak akses.
<IfModule mod_authz_core.c>
  Require all denied
</IfModule>
<IfModule !mod_authz_core.c>
  Order deny,allow
  Deny from all
</IfModule>
